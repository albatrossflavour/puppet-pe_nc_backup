<%- | Hash $config | -%>
#!/opt/puppetlabs/puppet/bin/ruby
# frozen_string_literal: true
#
# Managed by Puppet (pe_nc_backup), local changes will be overwritten.
#
# Backs up the Puppet Enterprise node classifier's groups as JSON and commits
# any changes to the git repo in <path>/repo.
#
# Usage: pe_nc_backup [path] [certname]
#
# Author: Jesse Reynolds - Puppet, Inc. - jesse.reynolds@puppet.com

<%= file('pe_nc_backup/pe_nc_backup.rb') %>
config = JSON.parse(<<~'CONFIG')
<%= stdlib::to_json_pretty($config) -%>
CONFIG
config['path'] = ARGV[0] unless ARGV[0].to_s.empty?
config['certname'] = ARGV[1] unless ARGV[1].to_s.empty?

exit PeNcBackup.main(config)
